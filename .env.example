# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already in .gitignore.

# --- SMTP (required for the contact form to send email) ---
# Any standard SMTP provider works: Gmail (with an App Password), Zoho,
# SendGrid, Mailgun, Amazon SES, your hosting provider's mail server, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Sender address shown on outgoing emails. Must be an address your SMTP
# provider allows you to send as (often the same as SMTP_USER).
SMTP_FROM=no-reply@example.com

# Inbox that receives new consulting inquiries (PDF attached automatically).
CONTACT_INBOX=owner@example.com

# --- Site URL (used for canonical links, sitemap.xml, robots.txt, Open Graph, JSON-LD) ---
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- GitHub OAuth App (required for /admin login — the content editor) ---
# Create at https://github.com/settings/applications/new with:
#   Homepage URL:              <your site URL>
#   Authorization callback URL: <your site URL>/api/auth/callback
# See README.md "Admin Panel" for the full walkthrough.
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret
